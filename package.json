{
  "name": "linkedin-automation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/dashboard-ui/tsconfig.json",
    "test": "bun test",
    "dashboard:build": "bun scripts/build-dashboard.ts",
    "dev": "bun run dashboard:build && bun --env-file=.env run src/index.ts",
    "start": "bun run dashboard:build && bun --env-file=.env run src/index.ts",
    "db:push": "drizzle-kit push",
    "clear-data": "bun --env-file=.env run scripts/clear-data.ts"
  },
  "dependencies": {
    "@mastra/agent-browser": "0.4.0",
    "@mastra/core": "1.48.0",
    "@mastra/pg": "1.15.1",
    "@opentui/core": "0.4.3",
    "@opentui/solid": "0.4.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "agent-browser": "0.19.0",
    "bullmq": "5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.26.0",
    "node-notifier": "^10.0.1",
    "open": "^11.0.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "playwright-core": "1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "solid-js": "1.9.14",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "patchedDependencies": {
    "playwright-core@1.61.1": "patches/playwright-core@1.61.1.patch"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "@types/node-notifier": "^8.0.5",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "agent-browser",
    "bun"
  ]
}
